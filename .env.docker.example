# Outline standalone (docker-compose.standalone.yml) configuration.
#
# Setup:
#   cp .env.docker.example .env
#   openssl rand -hex 32   # -> SECRET_KEY
#   openssl rand -hex 32   # -> UTILS_SECRET
#   set a strong POSTGRES_PASSWORD and mirror it inside DATABASE_URL
#
# The real .env is gitignored and never baked into the image. See .env.sample
# for the full list of optional settings (S3 storage, OAuth, integrations, etc).

NODE_ENV=production
URL=http://localhost:3000
PORT=3000                               # in-container port (keep 3000)
# OUTLINE_HOST_PORT=3000                # host port published by compose; change if 3000 is taken (then update URL to match)
FORCE_HTTPS=false                       # must be false for plain-http localhost

# Generate each with: openssl rand -hex 32
SECRET_KEY=replace_with_openssl_rand_hex_32
UTILS_SECRET=replace_with_openssl_rand_hex_32

# Postgres — compose builds the DB service from these; keep DATABASE_URL in sync.
POSTGRES_USER=outline
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=outline
DATABASE_URL=postgres://outline:replace_with_a_strong_password@postgres:5432/outline
PGSSLMODE=disable                       # local Postgres has no SSL; required or DB connect fails

REDIS_URL=redis://redis:6379

# Local disk storage (matches the image's FILE_STORAGE_LOCAL_ROOT_DIR / volume).
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

# Auth — the custom local username/password provider (satisfies "at least one auth method").
PASSWORD_AUTH_ENABLED=true

DEFAULT_LANGUAGE=en_US

# Optional SMTP — only needed for password-reset / email verification flows.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
